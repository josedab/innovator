{
  "name": "@innovator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "docs:api": "typedoc --out ../../website/docs/api --entryPointStrategy expand src/"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  }
}
