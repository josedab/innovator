{
  "name": "@innovator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./storage/sqlite": {
      "import": "./dist/storage/sqlite.js",
      "types": "./dist/storage/sqlite.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "docs:api": "typedoc --out ../../website/docs/api --entryPointStrategy expand src/"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typedoc": "^0.27.0",
    "typescript": "^5.6.0"
  }
}
