# Copilot SDK - uses your GitHub Copilot subscription
# Local development can reuse `gh auth login`; production requires GH_TOKEN.
# Optional: specify a default model
INNOVATOR_DEFAULT_MODEL=gpt-4.1

# --- Production Runtime (all required together) ---

# Production is a headless, single-process, single-tenant API profile.
# Do not uncomment NODE_ENV=production for normal local development.
# NODE_ENV=production
# INNOVATOR_DEPLOYMENT_PROFILE=single-tenant

# One or more unique comma-separated keys, each at least 32 characters.
# Clients authenticate with X-API-Key or a bearer-scheme Authorization header.
# INNOVATOR_API_KEYS=replace-with-a-unique-32-character-or-longer-key

# Required by the production Copilot provider.
# GH_TOKEN=ghp_...

# Dev server port (default: 3000)
# PORT=3000

# Legacy development-only single-key setting. Do not combine this with
# INNOVATOR_API_KEYS. Production deployments must use INNOVATOR_API_KEYS.
# INNOVATOR_API_KEY=

# Development may leave both key variables unset for anonymous local requests.
# Clients authenticate via X-API-Key or a bearer-scheme Authorization header.

# Optional: LLM request timeout in milliseconds (default: 90000)
# INNOVATOR_LLM_TIMEOUT_MS=90000

# Optional: comma-separated list of additional model IDs to allow
# INNOVATOR_EXTRA_MODELS=my-custom-model,another-model

# /api/embed is development/experimental and returns 404 in production.
# Optional development key for the /api/embed endpoint.
# INNOVATOR_EMBED_API_KEY=

# Optional: comma-separated CORS origins for /api/embed widget endpoint (default: *)
# INNOVATOR_EMBED_ORIGINS=https://mysite.com,https://docs.mysite.com

# Optional: base URL for Playwright E2E tests (default: http://localhost:3000)
# Used by apps/web/playwright.config.ts. CI environments may need to customize this.
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Alternative LLM Providers (development/experimental only) ---
# The first production profile requires the Copilot provider and GH_TOKEN.

# Optional: OpenAI API key for direct OpenAI provider
# OPENAI_API_KEY=sk-...
# Optional: Custom OpenAI-compatible base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Anthropic API key for direct Anthropic provider
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: Custom Anthropic-compatible base URL (default: https://api.anthropic.com/v1)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional: Ollama base URL for local LLM inference (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# --- Standard Node.js Environment Variables ---

# Node environment. Next.js sets this automatically; override if needed.
# Used by apps/web/src/proxy.ts to enable dev-mode logging.
# NODE_ENV=development

# Set to "true" in CI runners. Controls Playwright retries, parallelism, and web server behavior.
# CI=true

# Automatically set by npm to the version from the closest package.json.
# Read by apps/web/src/app/api/health/route.ts to report the current build version.
# npm_package_version=0.3.0

# --- Website / Documentation (Docusaurus) ---

# Optional: Algolia DocSearch credentials for the documentation site search
# ALGOLIA_APP_ID=your-app-id
# ALGOLIA_SEARCH_KEY=your-search-api-key
# ALGOLIA_INDEX_NAME=innovator

# --- SaaS / Billing (development/experimental only) ---
# Billing routes return 404 in the production profile.
# Required for billing features. See packages/core/src/saas/stripe-billing.ts.

# Required (if billing enabled): Stripe secret API key for server-side billing operations.
# STRIPE_SECRET_KEY=sk_test_...

# Required (if billing enabled): Stripe webhook signing secret for verifying incoming webhook events.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Stripe Price IDs for subscription plans. Defaults shown below.
# STRIPE_PRICE_PRO=price_pro_monthly
# STRIPE_PRICE_TEAM=price_team_monthly
# STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
# STRIPE_PRICE_STARTER=price_starter_monthly

# Optional: Stripe publishable key for client-side billing UI.
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- SaaS / GitHub OAuth (development/experimental only) ---
# OAuth routes return 404 in the production profile.
# Required for GitHub OAuth login. See packages/core/src/saas/github-oauth.ts.

# Required (if OAuth enabled): GitHub OAuth App client ID.
# GITHUB_CLIENT_ID=

# Required (if OAuth enabled): GitHub OAuth App client secret.
# GITHUB_CLIENT_SECRET=

# Optional: OAuth callback URL (default: http://localhost:3000/api/auth/callback)
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- SaaS / Google OAuth (development/experimental only) ---
# OAuth routes return 404 in the production profile.
# Required for Google OAuth login. See packages/core/src/saas/google-oauth.ts.

# Required (if Google OAuth enabled): Google OAuth client ID.
# GOOGLE_CLIENT_ID=

# Required (if Google OAuth enabled): Google OAuth client secret.
# GOOGLE_CLIENT_SECRET=

# Optional: Google OAuth callback URL (default: http://localhost:3000/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- SaaS / Database (development/experimental only) ---

# The PostgreSQL adapter is not implemented for the first production profile.
# Do not configure DATABASE_URL for the production Docker Compose deployment.
# DATABASE_URL=postgresql://innovator:password@localhost:5432/innovator

# --- MCP Server ---

# The MCP server supports stdio transport only. Filesystem tools are restricted
# to this root (default: the MCP process working directory).
# MCP_ALLOWED_ROOT=/absolute/path/to/allowed/repository

# GitHub App-based Copilot Extensions were retired on November 10, 2025.
# packages/copilot-extension is a migration stub and has no runtime settings.
